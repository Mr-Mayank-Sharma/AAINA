{
  "name": "aayna",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "dev:api": "npm run dev --workspace services/api",
    "dev:kiosk": "npm run dev --workspace apps/kiosk",
    "dev:display": "npm run dev --workspace apps/display",
    "dev:admin": "npm run dev --workspace apps/admin",
    "test": "npm run test --workspace services/api"
  }
}
